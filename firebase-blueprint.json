{
  "entities": {
    "users": {
      "title": "Parent Users",
      "description": "Registered parent accounts with settings and active subscriptions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["parent", "admin"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "children": {
      "title": "Child Profiles",
      "description": "Learning profiles for each child connected to a parent",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "parentId": { "type": "string" },
        "name": { "type": "string" },
        "grade": { "type": "string" },
        "age": { "type": "number" },
        "avatarId": { "type": "string" },
        "totalStars": { "type": "number" },
        "completedModules": { "type": "array", "items": { "type": "string" } },
        "badgesEarned": { "type": "array", "items": { "type": "string" } },
        "quizHistory": { "type": "object" }
      },
      "required": ["id", "parentId", "name", "grade", "avatarId"]
    },
    "subscriptions": {
      "title": "Parent Subscriptions",
      "description": "Active subscription packages and tier status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "parentId": { "type": "string" },
        "planId": { "type": "string" },
        "planName": { "type": "string" },
        "status": { "type": "string" },
        "startedAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["id", "parentId", "planId", "status"]
    }
  }
}
